{
  "name": "ex-workflow",
  "version": "0.1.0",
  "description": "Methodology engine for AI teams: Scrum, Kanban and Waterfall as data-driven state machines on top of ex-flow",
  "license": "MIT",
  "type": "module",
  "author": "Supakit Kitjaroen",
  "repository": { "type": "git", "url": "git+https://github.com/Ink01101011/ex-workflow.git" },
  "homepage": "https://github.com/Ink01101011/ex-workflow#readme",
  "keywords": ["scrum", "kanban", "waterfall", "workflow", "orchestration", "ai-agents", "ex-flow"],
  "packageManager": "pnpm@10.24.0",
  "engines": { "node": ">=18" },
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": { "exwf": "dist/cli/bin.cjs" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.mjs", "require": "./dist/index.cjs", "default": "./dist/index.mjs" },
    "./scrum": { "types": "./dist/scrum/index.d.ts", "import": "./dist/scrum/index.mjs", "require": "./dist/scrum/index.cjs", "default": "./dist/scrum/index.mjs" },
    "./cli": { "types": "./dist/cli/index.d.ts", "import": "./dist/cli/index.mjs", "require": "./dist/cli/index.cjs", "default": "./dist/cli/index.mjs" },
    "./types": { "types": "./dist/types.d.ts", "default": "./dist/types.d.ts" }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "test": "tsx --test \"src/**/*.test.ts\" \"test/**/*.test.ts\"",
    "build": "tsup",
    "minify": "tsup --minify",
    "lint": "oxlint src test",
    "format": "oxfmt src test",
    "format:check": "oxfmt --check src test",
    "typecheck": "tsc --noEmit",
    "size": "node scripts/size.mjs",
    "ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm minify && pnpm size",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "pnpm ci"
  },
  "dependencies": {
    "ex-flow": "^1.1.0",
    "exsorted": "^1.2.3"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.19.0",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
